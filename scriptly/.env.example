# Frontend URL (Better Auth client + OAuth callbacks). Same origin as the Vite app.
VITE_FRONTEND_URL=http://localhost:5173

# API base URL. Use the frontend URL so cookies work (Vite proxy / Vercel rewrites forward /api to backend).
VITE_API_BASE_URL=http://localhost:5173

# Production (set in Vercel dashboard):
# VITE_FRONTEND_URL=https://scriplty.vercel.app
# VITE_API_BASE_URL=https://scriplty.vercel.app
